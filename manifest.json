{
  "manifest_version": 3,
  "name": "西湖教学大纲下载器",
  "version": "0.2.1",
  "description": "恢复教学大纲下载按钮，并在我的课表中查询未选课程的大纲。",
  "content_scripts": [
    {
      "matches": [
        "https://ams.westlake.edu.cn/onlinefile/pdfjs/web/viewer.html*"
      ],
      "js": [
        "src/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ams.westlake.edu.cn/student/for-std/course-table*"
      ],
      "js": [
        "src/catalog-data.js",
        "src/catalog.js"
      ],
      "css": [
        "src/catalog.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
